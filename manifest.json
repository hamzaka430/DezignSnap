{
  "manifest_version": 3,
  "name": "DezignSnap — AI Visual Assistant",
  "version": "2.1.1",
  "author": "Muhammad Hamza / Dezignwise",
  "homepage_url": "https://dezignsnap.dezignwise.com",
  "description": "Capture screenshots or snip areas for instant visual AI answers, MCQ solving, and UI audit powered by Groq, Gemini, and GPT-4o.",
  "permissions": ["storage", "activeTab", "unlimitedStorage", "contextMenus"],
  "host_permissions": [
    "<all_urls>",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "http://localhost:11434/*"
  ],
  "commands": {
    "snip_screen": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Trigger DezignSnap Area Snip"
    },
    "solve_full_page": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Capture & Solve Full Page"
    },
    "toggle_stealth": {
      "suggested_key": {
        "default": "Alt+H",
        "mac": "Alt+H"
      },
      "description": "Toggle Screen Share Stealth Mode"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DezignSnap",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css", "icons/*", "assests/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
